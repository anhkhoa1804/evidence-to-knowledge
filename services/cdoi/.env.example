# Optional settings for CDOI. Copy to .env and fill in locally; .env is git-ignored.
# The default demo and test suite need none of these: unset values produce
# persisted `skipped` results instead of failures.

# OpenAI-compatible model gateway (see src/cdoi/model_config.py)
CDOI_LLM_PROVIDER=openai-compatible
CDOI_LLM_MODEL=
CDOI_LLM_BASE_URL=
CDOI_LLM_HOST_HEADER=
CDOI_LLM_TEMPERATURE=0
CDOI_LLM_MAX_TOKENS=256
# Name of the variable that holds the API key, and the key itself.
CDOI_LLM_API_KEY_ENV=DMP_MERCURY
DMP_MERCURY=

# Read-only enterprise observability sources (see src/cdoi/enterprise_sources.py).
# Base URLs must be absolute HTTPS URLs. Keep *_TLS_VERIFY=true outside an
# explicitly authorized staging host.
COROOT_BASE_URL=
COROOT_USERNAME=
COROOT_PASSWORD=
COROOT_TLS_VERIFY=true
COROOT_STAGING_HOST=observability.example.test

KIBANA_BASE_URL=
KIBANA_USERNAME=
KIBANA_PASSWORD=
KIBANA_DATA_VIEW_ID=
KIBANA_TLS_VERIFY=true
KIBANA_STAGING_HOST=logs.example.test
