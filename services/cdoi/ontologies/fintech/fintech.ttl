@prefix ft: <https://example.org/vt/fintech/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ft:Ontology a owl:Ontology .
ft:Wallet a owl:Class ; rdfs:label "Wallet" .
ft:PaymentAccount a owl:Class ; rdfs:label "Payment Account" .
ft:PaymentOrder a owl:Class ; rdfs:label "Payment Order" .
