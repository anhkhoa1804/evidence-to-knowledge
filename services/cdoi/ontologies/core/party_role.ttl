@prefix core: <https://example.org/vt/core/party-role/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

core:Ontology a owl:Ontology ; rdfs:label "Reusable party and role module" .
core:PartyRole a owl:Class ; rdfs:label "Party Role" ; rdfs:comment "A role held by a party in a contextual relationship." .
